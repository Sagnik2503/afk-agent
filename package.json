        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "commander": "^15.1.0"
    }
