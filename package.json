{
    "$schema": "https://json.schemastore.org/package",
    "name": "afk-agent",
    "version": "1.0.0",
    "description": "afk-agent",
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "index.js",
    "overrides": {
        "minimatch": "^11.0.8"
